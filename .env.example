# OPENROUTER_API_KEY: Required for OpenRouter AI API calls (NVIDIA Nemotron 3.5 Super VL).
# Set in Vercel as OPENROUTER_API_KEY
OPENROUTER_API_KEY="sk-or-v1-..."

# GEMINI_API_KEY: Optional fallback for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
